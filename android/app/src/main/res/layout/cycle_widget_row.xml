<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="0dp"
 android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:id="@+id/cycle_icon" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp"
  android:background="@drawable/cycle_icon_background" android:src="@drawable/ic_washer" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
  <TextView android:id="@+id/cycle_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
   android:textColor="#12211E" android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
  <ProgressBar android:id="@+id/cycle_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp"
   android:layout_marginVertical="3dp" android:max="1000" android:progressTint="#186E5A" android:progressBackgroundTint="#E4E6E0"/>
  <TextView android:id="@+id/cycle_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
   android:textColor="#62716B" android:textSize="11sp"/>
 </LinearLayout>
 <Chronometer android:id="@+id/cycle_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
  android:textColor="#12211E" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
 <TextView android:id="@+id/cycle_static" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
  android:textColor="#12211E" android:textSize="15sp" android:textStyle="bold" android:visibility="gone"/>
</LinearLayout>
